+        print_trapframe(tf);
+        break;
+    }
+}
+
+void exception_handler(struct trapframe *tf) {
+    switch (tf->cause) {
+    case CAUSE_MISALIGNED_FETCH:
+        cprintf("Instruction address misaligned\n");
+        print_trapframe(tf);
+        break;
+    case CAUSE_FAULT_FETCH:
+        cprintf("Instruction access fault\n");
+        print_trapframe(tf);
+        break;
